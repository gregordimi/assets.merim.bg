# Environment variables for local development or custom server path overrides
# Defaults point to the production Hetzner persistent volume:
# ASSETS_DATA_PATH=/mnt/volume-fsn1-1/assets-cdn/data
# ASSETS_CONF_PATH=/mnt/volume-fsn1-1/assets-cdn/nginx.conf

# For local testing on macOS/Linux:
ASSETS_DATA_PATH=./data
ASSETS_CONF_PATH=./nginx.conf
