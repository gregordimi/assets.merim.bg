# ==============================================================================
# Server & Sync Settings
# ==============================================================================
# Your Hetzner VPS IP or domain:
SERVER_IP=

# Path to the source images on your local machine:
# (Defaults to ../merim-bg-landing/public/storage if left blank)
LOCAL_ASSETS_DIR=../merim-bg-landing/public/storage

# Destination directory on the Hetzner server persistent volume:
REMOTE_ASSETS_DIR=/mnt/volume-fsn1-1/assets-cdn/data/

# ==============================================================================
# Docker Compose Local Overrides (optional)
# ==============================================================================
ASSETS_DATA_PATH=/mnt/volume-fsn1-1/assets-cdn/data
ASSETS_CONF_PATH=/mnt/volume-fsn1-1/assets-cdn/nginx.conf
