# ==============================================================================
# Server & Sync Settings
# ==============================================================================
# Your Hetzner VPS IP or SSH host alias (from ~/.ssh/config):
SERVER_IP=46.224.68.174

# SSH user on the server (e.g. root, ubuntu, or leave empty if using ~/.ssh/config alias)
SERVER_USER=root

# Optional: Path to specific private SSH key (e.g. ~/.ssh/id_ed25519 or ~/.ssh/id_rsa)
SSH_KEY=~/.ssh/id_ed25519

# Optional: SSH port (default is 22)
SSH_PORT=22

# Path to the source images on your local machine:
# (Defaults to ../merim-bg-landing/public/storage if left blank)
LOCAL_ASSETS_DIR=../merim-bg-landing/public/storage

# Destination directory on the Hetzner server volume:
REMOTE_ASSETS_DIR=/mnt/volume-fsn1-1/assets.merim.bg/data/
